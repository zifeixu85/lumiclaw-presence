{
  "name": "@lumiclaw/db",
  "version": "0.0.0-m0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:up": "node-pg-migrate up -m ${MIGRATIONS_DIR:-migrations} --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down -m ${MIGRATIONS_DIR:-migrations} --database-url-var DATABASE_URL",
    "probe": "node dist/probe.js"
  },
  "dependencies": {
    "@lumiclaw/domain": "*",
    "kysely": "0.29.4",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  }
}

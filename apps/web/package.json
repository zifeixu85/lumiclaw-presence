{
  "name": "@lumiclaw/web",
  "version": "0.1.0-m1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "postbuild": "node ../../scripts/prepare-web-standalone.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/apps/web/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --no-open",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@lumiclaw/domain": "*",
    "@lumiclaw/i18n": "*",
    "next": "16.3.0",
    "next-intl": "4.13.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/nextjs-vite": "10.5.5",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.26",
    "storybook": "10.5.5",
    "tailwindcss": "4.3.3"
  }
}

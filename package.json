{
  "name": "lumiclaw-presence",
  "version": "0.2.0-m2",
  "private": true,
  "description": "Governed six-member AgentTeams SHADOW Campaign for LumiClaw Presence; no external action path.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "packageManager": "npm@11.13.0",
  "overrides": {
    "nanoid": "3.3.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:runtime",
    "build:packages": "tsc -b --force packages/blob-store/tsconfig.json packages/domain/tsconfig.json packages/providers/tsconfig.json packages/mission-compiler/tsconfig.json packages/db/tsconfig.json packages/governed-shadow/tsconfig.json packages/i18n/tsconfig.json packages/process-health/tsconfig.json packages/runtime-agentteams/tsconfig.json",
    "build:runtime": "npm run build:packages && npm run build --workspace @lumiclaw/model-gateway && npm run build --workspace @lumiclaw/api && npm run build --workspace @lumiclaw/mission-worker && npm run build --workspace @lumiclaw/action-operator && npm run build --workspace @lumiclaw/web",
    "storybook": "npm run storybook --workspace @lumiclaw/web",
    "storybook:build": "npm run build:packages && npm run storybook:build --workspace @lumiclaw/web && npm run check:storybook-browser-safety",
    "check:messages": "node scripts/check-message-parity.mjs",
    "check:status": "node scripts/check-status-parity.mjs",
    "check:report": "node scripts/check-acceptance-report.mjs docs/reports/acceptance/SDD-002-ACCEPTANCE.md 12",
    "check:report:sdd004": "node scripts/check-acceptance-report.mjs docs/reports/acceptance/SDD-004-ACCEPTANCE.md 10",
    "check:report:sdd005": "node scripts/check-acceptance-report.mjs docs/reports/acceptance/SDD-005-ACCEPTANCE.md 10",
    "check:report:sdd006": "node scripts/check-acceptance-report.mjs docs/reports/acceptance/SDD-006-ACCEPTANCE.md 10",
    "check:report:sdd007": "node scripts/check-acceptance-report.mjs docs/reports/acceptance/SDD-007-ACCEPTANCE.md 18",
    "check:report:sdd008": "node scripts/check-acceptance-report.mjs docs/reports/acceptance/SDD-008-ACCEPTANCE.md 12",
    "check:report:sdd009": "node scripts/check-acceptance-report.mjs docs/reports/acceptance/SDD-009-ACCEPTANCE.md 12",
    "check:report:sdd010": "node scripts/check-acceptance-report.mjs docs/reports/acceptance/SDD-010-ACCEPTANCE.md 12",

    "verify:static": "npm run lint && npm run typecheck && npm run test && npm run check:messages && npm run check:status && npm run check:market-localization-evidence && npm run check:report && npm run check:report:sdd004 && npm run check:report:sdd005 && npm run check:report:sdd006 && npm run check:report:sdd007 && npm run check:report:sdd008 && npm run check:report:sdd009 && npm run check:report:sdd010 && npm run check:report:sdd012 && npm run check:secrets && npm run check:compose && npm run check:runtime-profile && npm run check:sdd007-runtime-manifest && npm run verify:dependencies",

    "check:compose": "node scripts/check-compose-policy.mjs",
    "check:runtime-profile": "npm run build --workspace @lumiclaw/domain && npm run build --workspace @lumiclaw/governed-shadow && tsx scripts/check-agentteams-profile.ts",

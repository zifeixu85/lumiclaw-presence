    "verify:sdd007:browser": "node scripts/verify-sdd007-browser.mjs",
    "verify:sdd007:compose": "node scripts/verify-sdd007-compose.mjs",
    "uat:live-deepseek": "node scripts/start-live-deepseek-uat.mjs",

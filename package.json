    "verify:live-agentteams-no-secret": "node scripts/verify-live-agentteams-no-secret.mjs",
    "verify:providers": "tsx scripts/verify-provider-conformance.ts && node scripts/verify-agentteams-role-projection.mjs",
    "verify:browser": "node scripts/verify-browser-runtime.mjs",
    "verify:sdd006:browser": "node scripts/verify-sdd006-browser.mjs",
    "verify:sdd006:compose": "node scripts/verify-sdd006-compose.mjs",
    "verify:sdd006:dependencies": "DEPENDENCY_EVIDENCE_ROOT=.evidence/sdd-006 npm run verify:dependencies",
    "verify:sdd008:browser": "node scripts/verify-sdd008-browser.mjs",
    "verify:sdd008:compose": "node scripts/verify-sdd008-compose.mjs",
    "verify:sdd008:dependencies": "DEPENDENCY_EVIDENCE_ROOT=.evidence/sdd-008 npm run verify:dependencies",
    "evidence:sdd009:golden": "npm run build --workspace @lumiclaw/domain && npm run build --workspace @lumiclaw/mission-compiler && node scripts/generate-sdd009-golden.mjs",
    "verify:sdd009:browser": "node scripts/verify-sdd009-browser.mjs",
    "verify:sdd009:compose": "node scripts/verify-sdd009-compose.mjs",
    "verify:sdd009:dependencies": "DEPENDENCY_EVIDENCE_ROOT=.evidence/sdd-009 npm run verify:dependencies",
    "evidence:sdd010:golden": "npm run build --workspace @lumiclaw/domain && npm run build --workspace @lumiclaw/mission-compiler && node scripts/generate-sdd010-golden.mjs",
    "verify:sdd010:browser": "node scripts/verify-sdd010-browser.mjs",
    "verify:sdd010:compose": "node scripts/verify-sdd010-compose.mjs",
    "verify:sdd010:dependencies": "DEPENDENCY_EVIDENCE_ROOT=.evidence/sdd-010 npm run verify:dependencies",
    "evidence:sdd012:media": "npm run build:packages && node scripts/generate-sdd012-media-evidence.mjs",
    "verify:sdd012:postgres": "npm run build:packages && node scripts/verify-sdd012-postgres.mjs",
    "verify:sdd012:compose": "node scripts/verify-sdd012-compose.mjs",
    "verify:sdd012:matrices": "node scripts/verify-sdd012-matrices.mjs",
    "evidence:sdd012:manifest": "node scripts/write-sdd012-run-manifest.mjs",
    "verify:sdd012:dependencies": "DEPENDENCY_EVIDENCE_ROOT=.evidence/sdd-012 npm run verify:dependencies",
    "verify:sdd012:compatibility": "npx vitest run packages/domain/src/knowledge-onboarding.test.ts apps/api/src/knowledge-onboarding-api.test.ts packages/domain/src/goal-plan.test.ts apps/api/src/goal-plan-api.test.ts apps/api/src/memory-goal-plan-repository.test.ts packages/domain/src/artifact-publish.test.ts apps/api/src/artifact-publish-api.test.ts apps/api/src/artifact-publish-memory-authority.test.ts packages/mission-compiler/src/persistent-runtime.test.ts scripts/persistent-runtime-secret-cli.test.ts",
    "runtime:secret:configure": "node scripts/persistent-runtime-secret-cli.mjs configure",
    "runtime:secret:prepare-fake": "node scripts/persistent-runtime-secret-cli.mjs prepare-controlled-fake",
    "runtime:secret:status": "node scripts/persistent-runtime-secret-cli.mjs status",
    "media:secret:configure": "node scripts/media-provider-secret-cli.mjs configure",
    "media:secret:status": "node scripts/media-provider-secret-cli.mjs status",
    "media:secret:remove": "node scripts/media-provider-secret-cli.mjs remove",
    "runtime:status": "node scripts/persistent-runtime-cli.mjs status",
    "runtime:compose:fake": "node scripts/run-persistent-runtime-compose.mjs fake up",
    "runtime:compose:deepseek": "node scripts/run-persistent-runtime-compose.mjs deepseek up",
    "runtime:compose:status": "node scripts/run-persistent-runtime-compose.mjs fake status",
    "runtime:compose:status:deepseek": "node scripts/run-persistent-runtime-compose.mjs deepseek status",
    "runtime:compose:stop": "node scripts/run-persistent-runtime-compose.mjs fake down",
    "runtime:compose:stop:deepseek": "node scripts/run-persistent-runtime-compose.mjs deepseek down",
    "runtime:supervisor": "node scripts/run-persistent-runtime-supervisor.mjs",
    "demo": "node scripts/run-initial-demo.mjs prepare",
    "demo:preflight": "node scripts/run-initial-demo.mjs preflight",
    "demo:complete": "node scripts/run-initial-demo.mjs complete",
    "demo:smoke": "node scripts/initial-demo-browser-smoke.mjs",
    "demo:evidence": "node scripts/run-initial-demo.mjs export",
    "demo:status": "node scripts/run-initial-demo.mjs status",
    "demo:stop": "node scripts/run-initial-demo.mjs stop",
    "demo:reset": "node scripts/run-initial-demo.mjs reset",
    "verify:initial-demo": "node scripts/verify-initial-demo-workflow.mjs",
    "evidence:package-source": "node scripts/package-source-evidence.mjs",
    "evidence:manifest": "node scripts/write-evidence-manifest.mjs"
  },

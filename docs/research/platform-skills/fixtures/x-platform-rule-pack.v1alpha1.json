  "rules": [
    {
      "ruleCode": "X_REGULAR_POST_WEIGHTED_LENGTH_MAX_280",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "A regular Post must be at most 280 weighted characters; Unicode code-point length is not the counting algorithm.",
      "sourceIds": ["X.HELP.POST", "X.SPEC.TWITTER_TEXT_V3"],
      "appliesWhen": { "artifactProfileCode": "X_SINGLE_POST", "capability.longPost": false },
      "constraint": { "operator": "MAX", "value": 280, "unit": "X_WEIGHTED_CHARACTER", "parserProfile": "twitter-text-v3" },
      "validation": { "validatorCode": "x.weighted_text.v3", "mode": "DETERMINISTIC" },
      "fallback": { "action": "DOWNGRADE_PROFILE", "reason": "Split into an approved X thread.", "fallbackProfileCode": "X_THREAD" }
    },
    {
      "ruleCode": "X_URL_WEIGHT_FIXED_23",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "Each URL is wrapped by t.co and consumes 23 weighted characters regardless of displayed URL length.",
      "sourceIds": ["X.HELP.LINKS", "X.SPEC.TWITTER_TEXT_V3"],
      "appliesWhen": { "contentContains": "URL" },
      "constraint": { "operator": "EQUALS", "value": 23, "unit": "X_WEIGHTED_CHARACTER_PER_URL" },
      "validation": { "validatorCode": "x.weighted_text.v3", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Recalculate with the canonical weighted parser." }
    },
    {
      "ruleCode": "X_IMAGE_POST_MEDIA_COUNT_1_TO_4",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "An image Post may attach one to four media identifiers.",
      "sourceIds": ["X.API.CREATE_POST", "X.HELP.IMAGES"],
      "appliesWhen": { "artifactProfileCode": "X_SINGLE_POST", "mediaKind": "IMAGE" },
      "constraint": { "operator": "BETWEEN_INCLUSIVE", "minimum": 1, "maximum": 4, "unit": "IMAGE" },
      "validation": { "validatorCode": "x.media.image_count", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Select at most four approved images." }
    },
    {
      "ruleCode": "X_IMAGE_FILE_SIZE_MAX_5_MB",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "An image uploaded through the documented composer path must not exceed 5 MB.",
      "sourceIds": ["X.HELP.IMAGES"],
      "appliesWhen": { "mediaKind": "IMAGE", "clientSurfaceCode": "X_WEB" },
      "constraint": { "operator": "MAX", "value": 5242880, "unit": "BYTE" },
      "validation": { "validatorCode": "media.file_size", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Re-export or compress without changing the approved content." }
    },
    {
      "ruleCode": "X_THREAD_ITEM_IMAGE_COUNT_0_TO_4",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "Each individual Post in a thread may attach zero to four images; this is evaluated per item, not as a total for the whole thread.",
      "sourceIds": ["X.API.CREATE_POST", "X.HELP.IMAGES", "X.HELP.THREAD"],
      "appliesWhen": { "artifactProfileCode": "X_THREAD", "mediaKind": "IMAGE" },
      "constraint": { "operator": "EACH_BETWEEN_INCLUSIVE", "minimum": 0, "maximum": 4, "unit": "IMAGE_PER_THREAD_ITEM" },
      "validation": { "validatorCode": "x.thread_each_image_count", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Select at most four approved images for the failing thread item." }
    },
    {
      "ruleCode": "X_IMAGE_ALT_TEXT_MAX_1000",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "Each still image or GIF description is at most 1,000 characters.",
      "sourceIds": ["X.HELP.ALT", "X.HELP.ACCESSIBILITY"],
      "appliesWhen": { "mediaKind": ["IMAGE", "GIF"] },
      "constraint": { "operator": "MAX", "value": 1000, "unit": "CHARACTER_PER_MEDIA_ITEM" },
      "validation": { "validatorCode": "x.image_alt_length", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Shorten the description while preserving essential context." }
    },
    {
      "ruleCode": "X_SINGLE_IMAGE_SAFE_DISPLAY_RATIO",
      "classification": "OFFICIAL_RECOMMENDATION",
      "severity": "WARN",
      "summary": "A single image between 2:1 and 3:4 can display fully in the documented composer experience.",
      "sourceIds": ["X.HELP.IMAGES"],
      "appliesWhen": { "mediaKind": "IMAGE", "mediaCount": 1 },
      "constraint": { "operator": "RATIO_BETWEEN_INCLUSIVE", "minimum": "3:4", "maximum": "2:1" },
      "validation": { "validatorCode": "media.aspect_ratio", "mode": "DETERMINISTIC" },
      "fallback": { "action": "WARN_AND_CONTINUE", "reason": "Require owner crop preview before approval." }
    },
    {
      "ruleCode": "X_VIDEO_CAPABILITY_LIMITS",
      "classification": "NEEDS_ACCOUNT_PROBE",
      "severity": "PROBE",
      "summary": "Video duration and size depend on tier, account, client and location; current official help pages also disagree on Premium limits.",
      "sourceIds": ["X.HELP.PREMIUM", "X.HELP.VIDEO"],
      "appliesWhen": { "artifactProfileCode": "X_VIDEO_POST" },
      "constraint": { "operator": "RESOLVE_FROM_CAPABILITY_SNAPSHOT", "safeUnknownMaximumSeconds": 140, "safeUnknownMaximumBytes": 536870912 },
      "validation": { "validatorCode": "capability.x.video_upload", "mode": "CAPABILITY_PROBE" },
      "fallback": { "action": "MANUAL_NATIVE_HANDOFF", "reason": "Use the last verified account/client limit; if absent, export within the documented non-Premium 140-second and 512-MB envelope." }
    },
    {
      "ruleCode": "X_VIDEO_CAPTION_REVIEW",
      "classification": "OFFICIAL_RECOMMENDATION",
      "severity": "WARN",
      "summary": "Video should carry accurate captions; X documents caption-file upload and automatic captions are not a substitute for review.",
      "sourceIds": ["X.HELP.ACCESSIBILITY"],
      "appliesWhen": { "artifactProfileCode": "X_VIDEO_POST" },
      "constraint": { "operator": "REQUIRE_REVIEWED_CAPTIONS" },
      "validation": { "validatorCode": "accessibility.video_captions", "mode": "AUDITOR_REVIEW" },
      "fallback": { "action": "WARN_AND_CONTINUE", "reason": "Owner must explicitly accept a missing-caption exception before publication." }
    },
    {
      "ruleCode": "X_THREAD_ITEM_WEIGHTED_LENGTH_MAX_280",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "Every regular Post in a thread independently follows the regular weighted-length contract.",
      "sourceIds": ["X.HELP.THREAD", "X.SPEC.TWITTER_TEXT_V3"],
      "appliesWhen": { "artifactProfileCode": "X_THREAD" },
      "constraint": { "operator": "EACH_MAX", "value": 280, "unit": "X_WEIGHTED_CHARACTER" },
      "validation": { "validatorCode": "x.thread_each_weighted_text.v3", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Edit or split the failing thread item and re-approve the exact revision." }
    },
    {
      "ruleCode": "X_THREAD_ITEM_COUNT_PRACTICAL_RANGE_3_TO_7",
      "classification": "EMPIRICAL_RECOMMENDATION",
      "severity": "WARN",
      "summary": "The first fixture uses three to seven items for owner reviewability; X publishes no stable public thread-size hard limit on the reviewed help page.",
      "sourceIds": ["X.HELP.THREAD"],
      "appliesWhen": { "artifactProfileCode": "X_THREAD" },
      "constraint": { "operator": "BETWEEN_INCLUSIVE", "minimum": 3, "maximum": 7, "unit": "POST" },
      "validation": { "validatorCode": "x.thread_practical_count", "mode": "OWNER_REVIEW" },
      "fallback": { "action": "WARN_AND_CONTINUE", "reason": "Allow an owner-approved exception; do not present 7 as a platform maximum." }
    },
    {
      "ruleCode": "X_POLL_OPTIONS_COUNT_2_TO_4",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "A poll contains two to four options.",
      "sourceIds": ["X.API.CREATE_POST"],
      "appliesWhen": { "artifactProfileCode": "X_POLL" },
      "constraint": { "operator": "BETWEEN_INCLUSIVE", "minimum": 2, "maximum": 4, "unit": "OPTION" },
      "validation": { "validatorCode": "x.poll.option_count", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Change the poll option count and re-approve." }
    },
    {
      "ruleCode": "X_POLL_OPTION_LENGTH_MAX_25",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "Each poll option contains one to 25 characters.",
      "sourceIds": ["X.API.CREATE_POST"],
      "appliesWhen": { "artifactProfileCode": "X_POLL" },
      "constraint": { "operator": "EACH_BETWEEN_INCLUSIVE", "minimum": 1, "maximum": 25, "unit": "CHARACTER" },
      "validation": { "validatorCode": "x.poll.option_length", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Shorten each option and re-approve." }
    },
    {
      "ruleCode": "X_POLL_DURATION_MINUTES_5_TO_10080",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "Poll duration is five to 10,080 minutes.",
      "sourceIds": ["X.API.CREATE_POST"],
      "appliesWhen": { "artifactProfileCode": "X_POLL" },
      "constraint": { "operator": "BETWEEN_INCLUSIVE", "minimum": 5, "maximum": 10080, "unit": "MINUTE" },
      "validation": { "validatorCode": "x.poll.duration", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Choose a supported duration and re-approve." }
    },
    {
      "ruleCode": "X_POLL_MEDIA_MUTUAL_EXCLUSION",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "The create-Post API does not permit poll data together with media, a quote Post, or a card URI.",
      "sourceIds": ["X.API.CREATE_POST"],
      "appliesWhen": { "artifactProfileCode": "X_POLL" },
      "constraint": { "operator": "MUTUALLY_EXCLUSIVE", "fields": ["poll", "media", "quoteTweetId", "cardUri"] },
      "validation": { "validatorCode": "x.poll.mutual_exclusion", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Choose a poll or media/quote/card, then re-approve." }
    },
    {
      "ruleCode": "X_HASHTAG_SYNTAX",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "A hashtag cannot contain spaces or punctuation; remaining hashtag use is bounded by the Post's weighted-length limit.",
      "sourceIds": ["X.HELP.HASHTAGS"],
      "appliesWhen": { "contentContains": "HASHTAG" },
      "constraint": { "operator": "MATCH_PLATFORM_HASHTAG_TOKENIZATION" },
      "validation": { "validatorCode": "x.hashtag.syntax", "mode": "DETERMINISTIC" },
      "fallback": { "action": "BLOCK", "reason": "Normalize hashtag tokens before approval." }
    },
    {
      "ruleCode": "X_HASHTAG_COUNT_UP_TO_2",
      "classification": "OFFICIAL_RECOMMENDATION",
      "severity": "WARN",
      "summary": "X recommends no more than two hashtags as a posting best practice; this is not a platform hard maximum.",
      "sourceIds": ["X.HELP.HASHTAGS"],
      "appliesWhen": { "contentContains": "HASHTAG" },
      "constraint": { "operator": "MAX", "value": 2, "unit": "HASHTAG" },
      "validation": { "validatorCode": "x.hashtag.recommended_count", "mode": "OWNER_REVIEW" },
      "fallback": { "action": "WARN_AND_CONTINUE", "reason": "Permit an owner-approved exception without relabeling it as compliant with the recommendation." }
    },
    {
      "ruleCode": "X_LONG_POST_MAX_25000_WHEN_CAPABLE",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "A longer Post is at most 25,000 characters only when the active account exposes the Premium longer-Post capability.",
      "sourceIds": ["X.HELP.PREMIUM"],
      "appliesWhen": { "artifactProfileCode": "X_LONG_POST", "capability.longPost": true },
      "constraint": { "operator": "MAX", "value": 25000, "unit": "CHARACTER" },
      "validation": { "validatorCode": "x.long_post.length", "mode": "DETERMINISTIC" },
      "fallback": { "action": "DOWNGRADE_PROFILE", "reason": "If capability is absent or stale, generate an approved thread instead.", "fallbackProfileCode": "X_THREAD" }
    },
    {
      "ruleCode": "X_ARTICLE_ACCOUNT_CAPABILITY",
      "classification": "NEEDS_ACCOUNT_PROBE",
      "severity": "PROBE",
      "summary": "Article publishing is subscription/account-gated and current official Premium text is internally inconsistent about tier naming.",
      "sourceIds": ["X.HELP.PREMIUM", "X.HELP.ARTICLES"],
      "appliesWhen": { "artifactProfileCode": "X_ARTICLE" },
      "constraint": { "operator": "REQUIRE_CURRENT_CAPABILITY", "capabilityCode": "X_ARTICLE_COMPOSER" },
      "validation": { "validatorCode": "capability.x.article_composer", "mode": "CAPABILITY_PROBE" },
      "fallback": { "action": "DOWNGRADE_PROFILE", "reason": "Use a long Post if verified, otherwise a thread.", "fallbackProfileCode": "X_THREAD" }
    },
    {
      "ruleCode": "X_API_USER_CONTEXT_WRITE_AUTH",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "Direct API publication requires approved developer access and a user-context token with the required write scopes.",
      "sourceIds": ["X.API.CREATE_POST", "X.API.OAUTH2_PKCE"],
      "appliesWhen": { "deliveryModeCode": "X_OFFICIAL_API_POC" },
      "constraint": { "operator": "REQUIRE_SCOPES", "scopes": ["tweet.read", "tweet.write", "users.read"] },
      "validation": { "validatorCode": "capability.x.oauth_scopes", "mode": "CAPABILITY_PROBE" },
      "fallback": { "action": "MANUAL_NATIVE_HANDOFF", "reason": "Never substitute cookies, browser scripting or an unofficial API." }
    },
    {
      "ruleCode": "X_AUTOMATION_AUTHENTICITY_REVIEW",
      "classification": "HARD_CONSTRAINT",
      "severity": "BLOCK",
      "summary": "Automation must not publish duplicate or substantially similar content across accounts or automate unsolicited interactions.",
      "sourceIds": ["X.POLICY.AUTOMATION"],
      "appliesWhen": { "deliveryModeCode": "X_OFFICIAL_API_POC" },
      "constraint": { "operator": "REQUIRE_POLICY_AUDIT" },
      "validation": { "validatorCode": "policy.x.automation", "mode": "AUDITOR_REVIEW" },
      "fallback": { "action": "BLOCK", "reason": "Escalate to owner and keep publication manual." }
    }
  ],
  "sourceConflicts": [
    {
      "conflictCode": "X_PREMIUM_VIDEO_LIMIT_CONFLICT_2026_08_22",
      "sourceIds": ["X.HELP.PREMIUM", "X.HELP.VIDEO"],
      "resolution": "Do not select a single universal Premium video limit. Resolve from an account/client CapabilitySnapshot and expire it after 14 days."
    }
  ]
}

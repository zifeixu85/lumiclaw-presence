{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumiclaw.org/schemas/platform-rule-pack.v1alpha1.json",
  "title": "LumiClaw PlatformRulePack research prototype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "platformCode",
    "packVersion",
    "status",
    "provenance",
    "applicability",
    "sources",
    "rules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "platform-rule-pack.v1alpha1" },
    "packId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "platformCode": { "enum": ["X", "XIAOHONGSHU"] },
    "packVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" },
    "status": { "enum": ["RESEARCH_PROTOTYPE", "ACTIVE", "EXPIRED", "SUPERSEDED"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrievedAt", "reviewedAt", "reviewCadenceDays", "expiresAt", "maintainer"],
      "properties": {
        "retrievedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewCadenceDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "maintainer": { "type": "string", "minLength": 1 },
        "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactProfileCodes", "marketCodes", "localeCodes", "deliveryModeCodes", "clientSurfaceCodes"],
      "properties": {
        "artifactProfileCodes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "marketCodes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "localeCodes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "deliveryModeCodes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "clientSurfaceCodes": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "sourceConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflictCode", "sourceIds", "resolution"],
        "properties": {
          "conflictCode": { "type": "string" },
          "sourceIds": { "type": "array", "items": { "type": "string" }, "minItems": 2, "uniqueItems": true },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "title",
        "url",
        "publisher",
        "authority",
        "sourceType",
        "retrievedAt",
        "sourceVersion",
        "reviewCadenceDays",
        "expiresAt"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[A-Z0-9._-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "publisher": { "type": "string", "minLength": 1 },
        "authority": { "enum": ["PLATFORM_OFFICIAL", "OFFICIAL_OPEN_SOURCE", "PROJECT_POLICY", "EMPIRICAL"] },
        "sourceType": { "enum": ["HELP", "API_DOC", "POLICY", "OPEN_SOURCE_SPEC", "ENTRY_POINT", "PROJECT_DOCUMENT", "ACCOUNT_PROBE"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "reviewCadenceDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleCode",
        "classification",
        "severity",
        "summary",
        "sourceIds",
        "appliesWhen",
        "validation",
        "fallback"
      ],
      "properties": {
        "ruleCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "classification": {
          "enum": ["HARD_CONSTRAINT", "OFFICIAL_RECOMMENDATION", "EMPIRICAL_RECOMMENDATION", "NEEDS_ACCOUNT_PROBE"]
        },
        "severity": { "enum": ["BLOCK", "WARN", "PROBE"] },
        "summary": { "type": "string", "minLength": 1 },
        "sourceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "appliesWhen": { "type": "object" },
        "constraint": { "type": "object" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validatorCode", "mode"],
          "properties": {
            "validatorCode": { "type": "string", "minLength": 1 },
            "mode": { "enum": ["DETERMINISTIC", "AUDITOR_REVIEW", "CAPABILITY_PROBE", "OWNER_REVIEW"] },
            "message": { "type": "string" }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "reason"],
          "properties": {
            "action": { "enum": ["BLOCK", "WARN_AND_CONTINUE", "DOWNGRADE_PROFILE", "MANUAL_NATIVE_HANDOFF", "REQUEST_OWNER_DECISION"] },
            "reason": { "type": "string", "minLength": 1 },
            "fallbackProfileCode": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "HARD_CONSTRAINT" } } },
          "then": { "properties": { "severity": { "const": "BLOCK" } } }
        },
        {
          "if": { "properties": { "classification": { "const": "NEEDS_ACCOUNT_PROBE" } } },
          "then": { "properties": { "severity": { "const": "PROBE" } } }
        }
      ]
    }
  }
}
